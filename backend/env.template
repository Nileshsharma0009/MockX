# Backend environment template. Copy to backend/.env for local development.
# Never commit real credentials. APP_ENV controls CORS policy; NODE_ENV controls Node runtime behavior.

# Server
PORT=10000
APP_ENV=development
NODE_ENV=development
TRUST_PROXY_HOPS=0

# Required database and authentication settings
MONGODB_URL=your_mongodb_connection_string_here
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

FRONTEND_URL=http://localhost:5173

# Comma-separated browser origins. Localhost ports are also allowed in development only.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional keep-alive ping. Disabled unless WEBSITE_URL is set.
# WEBSITE_URL=https://your-frontend-domain.example
# RELOAD_INTERVAL=30000

# Optional email settings used by existing email integrations
EMAIL_USER=your_email@example.com
EMAIL_PSAS=your_email_app_password
# Optional single-product Razorpay checkout. Payments stay disabled until enabled explicitly.
PAYMENTS_ENABLED=false
PAYMENT_PRODUCT_ID=your_mock_exam_id
PAYMENT_PRODUCT_NAME=your_product_name
PAYMENT_PRODUCT_PRICE=your_product_price
PAYMENT_CURRENCY=your_iso_currency_code
# PAYMENT_PRODUCT_PRICE may be omitted when a legacy PRICE_<NORMALIZED_PRODUCT_ID> is configured.
# Use matching TEST credentials locally/staging and LIVE credentials only in production.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
